# Generated by `make env` (scripts/init_env.py); every value is a random secret.
POSTGRES_PASSWORD=
GS_OWNER_PASSWORD=
GS_APP_PASSWORD=
REDIS_HEALTH_PW=
REDIS_API_PW=
REDIS_SIM_PW=
REDIS_INGEST_PW=
REDIS_ADMIN_PW=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ARCHIVER_SECRET=
S3_REPLAY_SECRET=
SESSION_SECRET=
DEMO_PW_CONDUCTOR=
DEMO_PW_FC1=
DEMO_PW_FC2=
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
SIM_HOST_PORT=8081
API_HOST_PORT=8000
GS_IMAGE_TAG=local
# Optional ingest overrides (not generated; uncomment to set). Defaults from docker-compose.yml:
# STEAL_IDLE_MS=30000    # owner-takeover threshold, D-ING-12 (system tests run 3000)
# RECLAIM_IDLE_MS=30000  # pending-entry reclaim threshold, D-ING-26 (system tests run 3000)
# GS_TEST_HOOKS=0        # 1 enables the CRASH_AT/STOP_AT/HANG_AT test hooks; never in production
# Optional archiver overrides (not generated). Defaults from docker-compose.yml:
# HOT_RETENTION_H=25     # hot rows are deleted once the hour is archived, verified and this old (>= 0)
# ARCHIVE_LOOP_S=300     # seconds between archiver passes (test control, T4-r)
